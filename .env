# ============================================================
# GetSetGrades environment variables example.
# Copy to `.env` (local) or set in your Vercel project settings.
# NEVER commit real `.env` files. NEVER put secrets under NEXT_PUBLIC_.
# ============================================================

# --- PUBLIC (safe to expose to the browser) ---

# Canonical production URL (no trailing slash). Used for canonical URLs,
# sitemap, OpenGraph tags. Required in production; missing => build warns.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Public hosted-checkout URL for your payment provider (e.g. Stripe Payment
# Link, Razorpay Payment Page). This is INTENTIONALLY public; it is only the
# hosted checkout page. Payment SECRETS must never use NEXT_PUBLIC_.
NEXT_PUBLIC_PAYMENT_LINK=https://www.paypal.com/ncp/payment/K79KML66T654L

# Display-only WhatsApp number for the site footer / contact cards.
NEXT_PUBLIC_WHATSAPP_NUMBER=919217614813

# --- SERVER-ONLY SECRETS (never expose to the browser) ---

# Database connection string — PostgreSQL, in every environment (no more
# SQLite fallback). A free Neon/Supabase branch works fine for local dev.
# See DEPLOYMENT.md for the full recipe.
DATABASE_URL=postgresql://user:password@host:5432/getsetgrades?sslmode=require

# Transactional email provider (Resend). When missing, the email helper
# gracefully no-ops (the DB submission still succeeds) and logs a notice.
# `EMAIL_FROM` MUST be an address authorized by your Resend account.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=GetSetGrades <hello@your-domain.example>
EMAIL_TO=heygetsetgrades@zohomail.in

# PayPal Payment Link is public; there is no PayPal webhook connected in this setup.
# Payment confirmation is reconciled manually by an authenticated admin.

# Admin dashboard credentials (server-only).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# AI chat provider (Groq). Server-only. When absent, /api/ai-chat returns 503.
GROQ_API_KEY=

# Optional distributed rate-limit backend (Upstash Redis REST).
# When both are set, /lib/rate-limit uses Redis across all Vercel instances.
# When absent, falls back to per-process in-memory limiting (dev only).
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# Optional salt for hashing client IPs (defaults to a fixed string).
# Not a secret per se, but should be stable across the deployment.
IP_HASH_SALT=
